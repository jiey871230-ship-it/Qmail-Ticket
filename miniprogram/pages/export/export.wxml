<view class="container">
  <!-- 收件地址 -->
  <view class="input-bar">
    <text class="input-label">收件地址</text>
    <view class="input-row">
      <input class="addr-input" type="text" placeholder="请输入收件邮箱地址"
             value="{{toAddress}}" bindinput="onToAddressInput" />
      <button class="btn-send" bindtap="sendEmail"
              disabled="{{sending || !toAddress}}">
        {{sending ? '...' : '发送'}}
      </button>
    </view>
  </view>

  <!-- 日期范围 -->
  <view class="section">
    <text class="section-title">日期范围</text>
    <view class="date-display">{{startDate}} 至 {{endDate}}</view>
  </view>

  <!-- 清空数据 -->
  <view class="section">
    <text class="section-title">数据管理</text>
    <button class="btn-danger" bindtap="clearData" disabled="{{clearing}}">
      {{clearing ? '清空中...' : '清空本地票据数据'}}
    </button>
  </view>

  <!-- 说明 -->
  <view class="section tips">
    <text class="section-title">说明</text>
    <text class="tips-text">• 发送邮件会重新连接邮箱解析所有票据</text>
    <text class="tips-text">• 附件包含：JPG图片、CSV汇总表、合并打印PDF</text>
    <text class="tips-text">• 整个过程约需 20-30 秒，请耐心等待</text>
  </view>
</view>

<!-- 进度弹窗 -->
<view class="progress-mask" wx:if="{{progress > 0}}">
  <view class="progress-dialog">
    <text class="progress-title">{{progressTitle}}</text>
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{progress}}%"></view>
    </view>
    <text class="progress-text">{{progress}}%</text>
  </view>
</view>
