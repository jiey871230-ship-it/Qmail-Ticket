page {
  --primary-color: #1890ff;
  --text-color: #333;
  --text-secondary: #666;
  --bg-color: #f5f5f5;
  --card-bg: #fff;
  --border-color: #eee;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: var(--bg-color);
}

.container {
  padding: 30rpx;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
